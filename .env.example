# Sem estas variáveis o app roda em modo demonstração (dados fictícios).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor: usado para criar/excluir usuários em Admin → Usuários.
SUPABASE_SERVICE_ROLE_KEY=
# Força o modo demonstração mesmo com Supabase configurado.
NEXT_PUBLIC_DEMO_MODE=false
